# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer the legacy anon JWT for App Router cookie auth (starts with eyJ…)
# Dashboard → Project Settings → API → "anon" "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# New-style keys also work for most APIs; keep secret server-only
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy secret name also supported:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (emails) ---
RESEND_API_KEY=re_xxxxxxxx
# REQUIRED after verifying rjstudio.ma in Resend (must be @rjstudio.ma, not studiorj.ma)
RESEND_FROM_EMAIL=RJ Studio <contact@rjstudio.ma>
# CONTACT_TO_EMAIL=contact@studiorj.ma
# BOOKING_ADMIN_EMAIL=contact@studiorj.ma

# --- Cron (Authorization: Bearer … on /api/cron/*) ---
CRON_SECRET=generate-a-long-random-string

# --- Site URL used in emails/links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
